# Copiar a .env (iniciar.ps1 lo hace solo la primera vez). El .env NO va a git: tiene secretos.

# --- general
# 1 en la PC; 0 en el servidor (con 0 hace falta SECRET_KEY y ALLOWED_HOSTS)
DEBUG=1
# En el servidor: una clave larga y al azar, por ejemplo la que da
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Dominios desde los que se entra, separados por coma (en el servidor)
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://visor.ejemplo.com
# Dirección de la app, sin https:// (en el servidor es obligatoria). Los talleres quedan en <esta>/<taller>/ y
# los links de los mails se arman con ella. En la PC, sin nada: 127.0.0.1:8000
# DOMINIO_APP=app.ejemplo.com

# --- base de datos
# Sin nada: SQLite en datos/dev.sqlite3. Con Docker (docker compose up -d):
# DATABASE_URL=postgres://visor:visor@localhost:5432/visor

# --- cola de conversiones (Huey)
# 1: las tareas corren en el mismo proceso, no hace falta levantar nada más (cómodo en la PC).
# 0: van a la cola y las hace el consumidor:  python app/manage.py run_huey
HUEY_INMEDIATO=1
# Sin REDIS_URL la cola se guarda en datos/huey.db. Con Docker:
# REDIS_URL=redis://localhost:6379/0
# HUEY_TRABAJADORES=2

# --- conversión de proyectos (cada una en un proceso aparte)
# CONVERSION_SEGUNDOS=600
# Límite de memoria en MB (solo en Linux; en Windows no se limita)
# CONVERSION_MEMORIA_MB=2048
# Tamaño máximo de lo que se sube, en MB (Cloudflare gratis corta en 100 MB)
# MAX_DXF_MB=95
# MAX_OCP_MB=10
# MAX_TEXTURA_MB=15

# --- marca del servicio (pie del link del cliente: "hecho con …")
# MARCA_SERVICIO=Visor
# MARCA_URL=https://ejemplo.com

# --- archivos (proyectos convertidos, texturas, GLB, fotos)
# local: carpeta datos/archivos/   r2: Cloudflare R2
ALMACENAMIENTO=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# --- mails (invitaciones y "me olvidé la contraseña")
# Sin EMAIL_URL los mails se guardan como archivos en datos/mails/ (para abrir los links en la PC).
# EMAIL_URL=smtp+tls://usuario:clave@servidor:587
# MAIL_REMITENTE=Visor <no-responder@ejemplo.com>
