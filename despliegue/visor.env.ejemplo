# config/visor.env del servidor (en el NAS: \\<NAS>\visor-saas-config\visor.env). NO va a git: tiene secretos.
# Copiar este archivo, completar lo que dice CAMBIAR y guardarlo como visor.env (sin .ejemplo).
# Para cambiar algo después: editar, guardar y en TrueNAS: Apps > visor-saas > Stop y Start.

# --- general
DEBUG=0
# CAMBIAR: una clave larga al azar (python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=
# CAMBIAR: la dirección de la app, sin https://
DOMINIO_APP=app-prueba.nordgood.com.ar
DETRAS_DE_CLOUDFLARE=1

# --- base de datos (el servicio "preparar" crea este usuario y esta base; el usuario NO es superusuario)
# CAMBIAR la clave (letras y números, sin símbolos raros)
DATABASE_URL=postgres://visor:CLAVE_DE_LA_BASE@postgres:5432/visor

# --- cola y caché
REDIS_URL=redis://redis:6379/0
HUEY_INMEDIATO=0
# Una conversión a la vez (el NAS tiene 8 GB compartidos)
HUEY_TRABAJADORES=1
CONVERSION_SEGUNDOS=600
# Tope de memoria de cada conversión en MB (memoria reservada). Ajustar con el log "memoria pico" (docs/operacion.md)
CONVERSION_MEMORIA_MB=1500

# --- archivos en Cloudflare R2 (se descargan desde Cloudflare, no gastan la subida de la casa)
ALMACENAMIENTO=r2
# CAMBIAR las cuatro
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=visor-saas
# Copias diarias de la base: bucket aparte, con su propia clave (solo ese bucket)
R2_COPIAS_BUCKET=visor-saas-copias
R2_COPIAS_ACCESS_KEY_ID=
R2_COPIAS_SECRET_ACCESS_KEY=

# --- mails (invitaciones y "me olvidé la contraseña"). Brevo: Settings > SMTP & API > SMTP
# CAMBIAR usuario y clave SMTP (el usuario de Brevo lleva @: escribirlo como %40)
EMAIL_URL=smtp+tls://USUARIO:CLAVE_SMTP@smtp-relay.brevo.com:587
MAIL_REMITENTE=Visor <no-responder@nordgood.com.ar>

# --- avisos de errores (Sentry). Sin SENTRY_DSN no se manda nada.
SENTRY_DSN=
SENTRY_ENTORNO=nas

# --- marca del servicio (pie del link del cliente)
MARCA_SERVICIO=Visor
